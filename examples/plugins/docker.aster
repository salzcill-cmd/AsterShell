name        = "docker-aliases"
version     = "0.1.0"
description = "Docker shortcuts for containers, images, and compose"
enabled     = true

[aliases]
dk  = "docker"
dkc = "docker compose"
dkps = "docker ps"
dka = "docker ps -a"
dkrm = "docker rm -f $(docker ps -aq)"
dkimg = "docker images"
dkrmi = "docker image prune -f"
dkvol = "docker volume ls"
dknet = "docker network ls"
dklog = "docker logs -f"
dkexec = "docker exec -it"
dkit = "docker system df"
dkprune = "docker system prune -af"
dkcp = "docker compose up -d"
dkdown = "docker compose down"
dklogc = "docker compose logs -f"
dkbuild = "docker compose build --no-cache"
dkpull = "docker compose pull"
dkstats = "docker stats --no-stream"
