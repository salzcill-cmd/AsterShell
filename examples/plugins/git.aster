name        = "git-aliases"
version     = "0.1.0"
description = "Quick git aliases for daily workflow"
enabled     = true

[aliases]
gs   = "git status"
ga   = "git add"
gaa  = "git add --all"
gc   = "git commit -m"
gcm  = "git commit -m"
gco  = "git checkout"
gcb  = "git checkout -b"
gd   = "git diff"
gl   = "git log --oneline --graph --decorate -20"
gp   = "git pull"
gpr  = "git pull --rebase"
gpu  = "git push"
gpf  = "git push --force-with-lease"
grb  = "git rebase"
grbi = "git rebase -i"
gst  = "git stash"
gstp = "git stash pop"
gwip = "git add -A && git commit -m 'WIP: work in progress'"
gundo = "git reset --soft HEAD~1"
gclean = "git clean -fd"
glast = "git log -1 --stat"
gwho = "git shortlog -sn"
