name        = "python-dev"
version     = "0.1.0"
description = "Python development shortcuts (venv, pip, pytest)"
enabled     = true

[aliases]
py   = "python3"
pyv  = "python3 -m venv .venv"
pya  = "source .venv/bin/activate"
pyi  = "pip install"
pyir = "pip install -r requirements.txt"
pyup = "pip install --upgrade pip"
pyl  = "pip list"
pys  = "pip show"
pyc  = "pytest"
pyco = "pytest --cov"
pycs = "pytest -v --tb=short"
pyf  = "black ."
pyfl = "black --check ."
pyi2 = "isort ."
pyt  = "mypy ."
pyr  = "python3 -m http.server"
pyserv = "uvicorn main:app --reload"
pyenv = "python3 -c 'import sys; print(sys.executable)'"
